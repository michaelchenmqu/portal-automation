# ─────────────────────────────────────────────
# Portal Stabilisation Automation — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Anthropic API Key
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Asana Personal Access Token
# Get from: https://app.asana.com/0/my-apps → Personal Access Tokens
ASANA_ACCESS_TOKEN=your-asana-token-here

# Slack Bot Token (must start with xoxb-)
# Get from: https://api.slack.com/apps → your app → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here

# Slack Channel ID for #portal-product-feedback
SLACK_CHANNEL_ID=C0AC8P92G3B

# Asana Project GID for Portal Stabilisation
ASANA_PROJECT_GID=1213802028079816

# Timezone (IANA format)
TIMEZONE=Australia/Sydney
